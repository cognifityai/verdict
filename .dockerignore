# The packaged dashboard image installs a published wheel and copies no
# repository source. Send only these build instructions to the Docker daemon.
*
!Dockerfile
!.dockerignore
!build/
!build/customer-managed/
!build/customer-managed/*.whl

# Final denies guard against future context allowlist changes.
*.db
*.db-*
*.[Ee][Nn][Vv]*
.[Dd][Ii][Rr][Ee][Nn][Vv]/
