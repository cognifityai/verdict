# Copy to .env and fill in your own keys. .env is gitignored — never commit it.
# Only the providers you actually use are required.

# Anthropic (Claude) — used by the SDK instrumentor target and as a judge/provider
ANTHROPIC_API_KEY=

# OpenAI — instrumentor target and judge/provider
OPENAI_API_KEY=

# Google Gemini — instrumentor target and judge/provider
# (GOOGLE_API_KEY takes precedence if both are set)
GEMINI_API_KEY=
GOOGLE_API_KEY=
