# Variable-name reference only. Do not copy this file to a plaintext file under
# the repository. Inject only the keys you need into the target process from a
# managed secret store or OS credential manager.

# Anthropic (Claude) — used by the SDK instrumentor target and as a judge/provider
ANTHROPIC_API_KEY=

# OpenAI — instrumentor target and judge/provider
OPENAI_API_KEY=

# Google Gemini — instrumentor target and judge/provider
# (GOOGLE_API_KEY takes precedence if both are set)
GEMINI_API_KEY=
GOOGLE_API_KEY=
